{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "hubl",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_node"
      }
    },
    "_node": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "comment"
        },
        {
          "type": "SYMBOL",
          "name": "statement"
        },
        {
          "type": "SYMBOL",
          "name": "expression"
        },
        {
          "type": "SYMBOL",
          "name": "content"
        }
      ]
    },
    "content": {
      "type": "PREC",
      "value": -1,
      "content": {
        "type": "PATTERN",
        "value": "([^{]|\\{[^{%#])+"
      }
    },
    "comment": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "comment_begin"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "comment_content"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "comment_end"
        }
      ]
    },
    "comment_begin": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "{#-"
        },
        {
          "type": "STRING",
          "value": "{#"
        }
      ]
    },
    "comment_end": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "-#}"
        },
        {
          "type": "STRING",
          "value": "#}"
        }
      ]
    },
    "comment_content": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "([^#]|#[^}]|-[^#]|--+[^#])*"
        }
      }
    },
    "expression": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "expression_begin"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_inner"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "expression_end"
        }
      ]
    },
    "expression_begin": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "{{-"
        },
        {
          "type": "STRING",
          "value": "{{"
        }
      ]
    },
    "expression_end": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "-}}"
        },
        {
          "type": "STRING",
          "value": "}}"
        }
      ]
    },
    "statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "statement_begin"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "keyword"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "_inner"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "statement_end"
        }
      ]
    },
    "statement_begin": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "{%-"
        },
        {
          "type": "STRING",
          "value": "{%"
        }
      ]
    },
    "statement_end": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "-%}"
        },
        {
          "type": "STRING",
          "value": "%}"
        }
      ]
    },
    "keyword": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 2,
        "content": {
          "type": "PATTERN",
          "value": "\\s*[a-zA-Z_][a-zA-Z0-9_]*"
        }
      }
    },
    "_inner": {
      "type": "REPEAT1",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "string"
          },
          {
            "type": "SYMBOL",
            "name": "number"
          },
          {
            "type": "SYMBOL",
            "name": "boolean"
          },
          {
            "type": "SYMBOL",
            "name": "none"
          },
          {
            "type": "SYMBOL",
            "name": "identifier"
          },
          {
            "type": "SYMBOL",
            "name": "operator"
          },
          {
            "type": "SYMBOL",
            "name": "comparison_operator"
          },
          {
            "type": "SYMBOL",
            "name": "assignment_operator"
          },
          {
            "type": "SYMBOL",
            "name": "filter"
          },
          {
            "type": "SYMBOL",
            "name": "attribute"
          },
          {
            "type": "SYMBOL",
            "name": "punctuation"
          },
          {
            "type": "SYMBOL",
            "name": "whitespace"
          },
          {
            "type": "SYMBOL",
            "name": "expression"
          }
        ]
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "\""
              },
              {
                "type": "PATTERN",
                "value": "([^\"\\\\]|\\\\.)*"
              },
              {
                "type": "STRING",
                "value": "\""
              }
            ]
          },
          {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "'"
              },
              {
                "type": "PATTERN",
                "value": "([^'\\\\]|\\\\.)*"
              },
              {
                "type": "STRING",
                "value": "'"
              }
            ]
          }
        ]
      }
    },
    "number": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\d+(\\.\\d+)?"
      }
    },
    "boolean": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "true"
          },
          {
            "type": "STRING",
            "value": "false"
          },
          {
            "type": "STRING",
            "value": "True"
          },
          {
            "type": "STRING",
            "value": "False"
          }
        ]
      }
    },
    "none": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "none"
          },
          {
            "type": "STRING",
            "value": "None"
          },
          {
            "type": "STRING",
            "value": "null"
          }
        ]
      }
    },
    "identifier": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -1,
        "content": {
          "type": "PATTERN",
          "value": "[a-zA-Z_][a-zA-Z0-9_]*"
        }
      }
    },
    "operator": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "+"
          },
          {
            "type": "STRING",
            "value": "-"
          },
          {
            "type": "STRING",
            "value": "**"
          },
          {
            "type": "STRING",
            "value": "*"
          },
          {
            "type": "STRING",
            "value": "//"
          },
          {
            "type": "STRING",
            "value": "/"
          },
          {
            "type": "STRING",
            "value": "%"
          },
          {
            "type": "STRING",
            "value": "~"
          },
          {
            "type": "STRING",
            "value": "!"
          },
          {
            "type": "STRING",
            "value": "not"
          },
          {
            "type": "STRING",
            "value": "and"
          },
          {
            "type": "STRING",
            "value": "or"
          },
          {
            "type": "STRING",
            "value": "is"
          }
        ]
      }
    },
    "comparison_operator": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "=="
          },
          {
            "type": "STRING",
            "value": "!="
          },
          {
            "type": "STRING",
            "value": "<="
          },
          {
            "type": "STRING",
            "value": ">="
          },
          {
            "type": "STRING",
            "value": "<"
          },
          {
            "type": "STRING",
            "value": ">"
          },
          {
            "type": "STRING",
            "value": "in"
          }
        ]
      }
    },
    "assignment_operator": {
      "type": "STRING",
      "value": "="
    },
    "filter": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "|"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "whitespace"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "attribute": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "."
        },
        {
          "type": "SYMBOL",
          "name": "identifier"
        }
      ]
    },
    "punctuation": {
      "type": "TOKEN",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "STRING",
            "value": "("
          },
          {
            "type": "STRING",
            "value": ")"
          },
          {
            "type": "STRING",
            "value": "["
          },
          {
            "type": "STRING",
            "value": "]"
          },
          {
            "type": "STRING",
            "value": "{"
          },
          {
            "type": "STRING",
            "value": "}"
          },
          {
            "type": "STRING",
            "value": ","
          },
          {
            "type": "STRING",
            "value": ":"
          },
          {
            "type": "STRING",
            "value": "?"
          }
        ]
      }
    },
    "whitespace": {
      "type": "TOKEN",
      "content": {
        "type": "PATTERN",
        "value": "\\s+"
      }
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}